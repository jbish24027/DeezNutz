 "Serana": [
  {
   "wav": "C:\\1. AUTHORIA\\_tools\\follower-banter\\voice-refs\\Serana\\ref1.wav",
   "text": "Me? I smell like nightshade and snowberries.",
   "dur": 4.27,
   "source_file": "C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--1--AUTHORIA\\f4941a5e-f3b7-4567-9232-2db3d3adf5f4\\scratchpad\\x\\serana\\sound\\voice\\seranadialogaddon.esp\\dlc1seranavoice\\sda_serana_sda_seranaroman_00fb72b9_1.fuz",
   "transcript_from": "Whisper large-v3-turbo"
  },
  {
   "wav": "C:\\1. AUTHORIA\\_tools\\follower-banter\\voice-refs\\Serana\\ref2.wav",
   "text": "Now you've got me thinking about the future. Maybe one day, we'll need that name.",
   "dur": 6.22,
   "source_file": "C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--1--AUTHORIA\\f4941a5e-f3b7-4567-9232-2db3d3adf5f4\\scratchpad\\x\\serana\\sound\\voice\\seranadialogaddon.esp\\dlc1seranavoice\\sda_moredi_sda_cc568ariel0_0000095e_1.fuz",
   "transcript_from": "Whisper large-v3-turbo"
  },
  {
   "wav": "C:\\1. AUTHORIA\\_tools\\follower-banter\\voice-refs\\Serana\\ref3.wav",
   "text": "You mean the world to me, and I couldn't have gone through all this without you, my love.",
   "dur": 5.8,
   "source_file": "C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--1--AUTHORIA\\f4941a5e-f3b7-4567-9232-2db3d3adf5f4\\scratchpad\\x\\serana\\sound\\voice\\seranadialogaddon.esp\\dlc1seranavoice\\sda_moredi_sda_customconvo_007c0727_2.fuz",
   "transcript_from": "Whisper large-v3-turbo"
  }
 ],
 "Ashe": [
  {
   "wav": "C:\\1. AUTHORIA\\_tools\\follower-banter\\voice-refs\\Ashe\\ref1.wav",
   "text": "I get that my past, my origins aren't what you'd expect. But that doesn't change who I am now, or the journey I'm on.",
   "dur": 7.01,
   "source_file": "C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--1--AUTHORIA\\f4941a5e-f3b7-4567-9232-2db3d3adf5f4\\scratchpad\\x\\ashe\\sound\\voice\\ashe - fire and blood.esp\\mm_ashevoice\\mm_friends_mm_friendshippd_002143bc_3.fuz",
   "transcript_from": "Whisper large-v3-turbo"
  },
  {
   "wav": "C:\\1. AUTHORIA\\_tools\\follower-banter\\voice-refs\\Ashe\\ref2.wav",
   "text": "Fine. But if something drags me into the shadows, you'd best come running.",
   "dur": 4.18,
   "source_file": "C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--1--AUTHORIA\\f4941a5e-f3b7-4567-9232-2db3d3adf5f4\\scratchpad\\x\\ashe\\sound\\voice\\ashe - fire and blood.esp\\mm_ashevoice\\mm_ashemen_mm_ashementalmo_00348721_1.fuz",
   "transcript_from": "Whisper large-v3-turbo"
  },
  {
   "wav": "C:\\1. AUTHORIA\\_tools\\follower-banter\\voice-refs\\Ashe\\ref3.wav",
   "text": "Yes, the tomes are essential. They contain the knowledge I need to analyze and incorporate.",
   "dur": 4.92,
   "source_file": "C:\\Users\\User\\AppData\\Local\\Temp\\claude\\C--1--AUTHORIA\\f4941a5e-f3b7-4567-9232-2db3d3adf5f4\\scratchpad\\x\\ashe\\sound\\voice\\ashe - fire and blood.esp\\mm_ashevoice\\mm_spellte_mm_spellteachin_00f2d683_1.fuz",
   "transcript_from": "Whisper large-v3-turbo"
  }
 ],
