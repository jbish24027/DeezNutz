	<!-- skirt, first joint under the belt: out up to 1.1 rad, in 0.08 (onto the legs), sideways 0.3, twist 0.12; springs hold the shape and calm the sway -->
	<generic-constraint-default>
		<frameInB>
			<basis x="0" y="0" z="0" w="1"/>
			<origin x="0" y="0" z="0"/>
		</frameInB>
		<useLinearReferenceFrameA>false</useLinearReferenceFrameA>
		<linearLowerLimit x="-0.0" y="-0.0" z="-0.0"/>
		<linearUpperLimit x="0.0" y="0.0" z="0.0"/>
		<angularLowerLimit x="-1.1" y="-0.3" z="-0.12"/>
		<angularUpperLimit x="0.08" y="0.3" z="0.12"/>
		<linearStiffness x="0" y="0" z="0"/>
		<angularStiffness x="24" y="6" z="6"/>
		<linearDamping x="0" y="0" z="0"/>
		<angularDamping x="0" y="0" z="0"/>
		<linearEquilibrium x="0" y="0" z="0"/>
		<angularEquilibrium x="0" y="0" z="0"/>
	</generic-constraint-default>
