<?xml version="1.0" encoding="UTF-8"?>
<!-- Realistic Armor - Tavern Clothes (clothes/wench), men: skirt, hip flaps and belt tip physics,
     rebuilt 2026-10-08 for this LoreRim setup (replaces the HDT patch's 8x3 panels; skirt feel after Companions Wolf Armor Redone v4).
     Skirt: 12 chains (pinned under the belt + 5 swinging bones), every point blending two chains and two rows; one piece all round.
     All skirt layers hang on the same chains, so they never fight each other. Where the skirt lies on the thighs it moves with
     them; where it hangs clear it swings.
     Collisions (hidden copies, this armour only): the skirt vs the trousers, split into front / side / back so a leg always
     pushes the skirt back out the way it came; ground.
     Nothing touches anything while standing. Swing limits per joint: X = out/in (negative = outward), Y = sideways, Z = twist.
     Tuning: edit, save, "smp reset". -->
<system xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="description.xsd">

	<per-triangle-shape name="VirtualGround">
		<margin>0.5</margin>
		<penetration>10</penetration>
		<shared>private</shared>
		<tag>ground</tag>
		<no-collide-with-tag>ground</no-collide-with-tag>
		<no-collide-with-tag>legsF</no-collide-with-tag>
		<no-collide-with-tag>legsS</no-collide-with-tag>
		<no-collide-with-tag>legsB</no-collide-with-tag>
	</per-triangle-shape>
	<!-- the trousers (hidden copies) in three one-sided pieces by facing: front, back, sides. Each part of the skirt meets only
	     the matching piece, so a leg that goes deep into it always pushes it back out the way it came, never hooks it behind the leg -->
	<per-triangle-shape name="AWN Legs Front">
		<margin>0.4</margin>
		<penetration>3.0</penetration>
		<shared>private</shared>
		<tag>legsF</tag>
		<no-collide-with-tag>legsF</no-collide-with-tag>
		<no-collide-with-tag>legsS</no-collide-with-tag>
		<no-collide-with-tag>legsB</no-collide-with-tag>
		<no-collide-with-tag>ground</no-collide-with-tag>
	</per-triangle-shape>
	<per-triangle-shape name="AWN Legs Back">
		<margin>0.4</margin>
		<penetration>3.0</penetration>
		<shared>private</shared>
		<tag>legsB</tag>
		<no-collide-with-tag>legsF</no-collide-with-tag>
		<no-collide-with-tag>legsS</no-collide-with-tag>
		<no-collide-with-tag>legsB</no-collide-with-tag>
		<no-collide-with-tag>ground</no-collide-with-tag>
	</per-triangle-shape>
	<per-triangle-shape name="AWN Legs Side">
		<margin>0.4</margin>
		<penetration>1.5</penetration>
		<shared>private</shared>
		<tag>legsS</tag>
		<no-collide-with-tag>legsF</no-collide-with-tag>
		<no-collide-with-tag>legsS</no-collide-with-tag>
		<no-collide-with-tag>legsB</no-collide-with-tag>
		<no-collide-with-tag>ground</no-collide-with-tag>
	</per-triangle-shape>

