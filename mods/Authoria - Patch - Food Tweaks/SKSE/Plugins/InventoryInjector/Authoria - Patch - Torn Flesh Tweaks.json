{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/InventoryInjector/main/docs/InventoryInjector.schema.json",
  "rules": [
    {
      "match": {
        "formId": {
          "anyOf": [
            "Requiem.esp|284894"
          ]
        }
      },
      "assign": {
        "subTypeDisplay": "Food",
        "iconSource": "AIT/MoreIcons/icons.swf",
        "iconLabel": "food_meat",
        "iconColor": "#A93226"
      }
    },
    {
      "match": {
        "formType": "Potion",
        "keywords": [
          "LoreBox_REQ_StrangeMeat"
        ]
      },
      "assign": {
        "subTypeDisplay": "Food",
        "iconSource": "AIT/MoreIcons/icons.swf",
        "iconLabel": "food_meat",
        "iconColor": "#A93226"
      }
    }
  ]
}
